# Rabbit dispatcher secrets. Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real API keys.
#
# These env vars are injected into the dispatcher container via
# docker-compose `env_file: .env`, and dispatch.yaml references them as
# ${VAR_NAME} in worker env blocks.

# codex workers (CODEX_BASE_URL=https://vsllm.com/v1)
OPENAI_API_KEY_CODEX=

# deepseek-v4-pro via xplt proxy (PI_BASE_URL=https://xplt.sdu.edu.cn:4000/v1)
PI_API_KEY_DS_XPLT=

# deepseek-v4-pro via official (PI_BASE_URL=https://api.deepseek.com:18443/v1)
PI_API_KEY_DS_OFFICIAL=

# glm-5.2 via xplt proxy
PI_API_KEY_GLM=
